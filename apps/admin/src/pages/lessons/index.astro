---
// Content → Lessons (docs/specs/back-office-content-review.md CR-1): every lesson with its status,
// who reviewed and build-tested it, and any change waiting to be merged.
import Admin from '../../layouts/Admin.astro';
import { githubFromEnv } from '../../lib/github-env';
import type { LessonSummary } from '../../lib/lessons';
import { pullsByLesson, readLessons } from '../../lib/review';
import { canSeeLessons } from '../../lib/roles';
import type { Pull } from '../../lib/github';

const { roles } = Astro.locals;
if (!canSeeLessons(roles)) return Astro.redirect('/', 303);

const STATUS_LABELS = { draft: 'Draft', in_review: 'In review', published: 'Published' } as const;
const show = Astro.url.searchParams.get('status');
const gh = githubFromEnv();
let lessons: LessonSummary[] = [];
let pulls = new Map<string, Pull>();
let error = '';
if (gh) {
  try {
    const [all, open] = await Promise.all([readLessons(gh), gh.openAdminPulls()]);
    lessons = all.filter((l) => !show || l.status === show);
    pulls = pullsByLesson(open);
  } catch {
    error = 'Could not read the lessons from GitHub. Try again in a minute.';
  }
}
const counts = (s: keyof typeof STATUS_LABELS) => lessons.filter((l) => l.status === s).length;
---

<Admin title="Lessons">
  {error && (
    <p class="error" role="alert">
      {error}
    </p>
  )}
  {!gh && <p class="error">The GitHub App is not set up yet. See docs/deploy.md §5.</p>}
  <nav aria-label="Filter by status">
    <ul class="filters">
      <li>
        <a href="/lessons/" aria-current={!show ? 'page' : undefined}>
          All
        </a>
      </li>
      {(Object.keys(STATUS_LABELS) as (keyof typeof STATUS_LABELS)[]).map((s) => (
        <li>
          <a href={`/lessons/?status=${s}`} aria-current={show === s ? 'page' : undefined}>
            {STATUS_LABELS[s]}
            {!show && ` (${counts(s)})`}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Lesson</th>
          <th scope="col">Grades</th>
          <th scope="col">Status</th>
          <th scope="col">Reviewed</th>
          <th scope="col">Built</th>
          <th scope="col">Waiting</th>
        </tr>
      </thead>
      <tbody>
        {lessons.map((l) => (
          <tr>
            <td>
              <a href={`/lessons/${l.id}/`}>{l.title}</a>
              <br />
              <small>
                {l.id}
                {l.aiGenerated && ' · AI-drafted'}
              </small>
            </td>
            <td>{l.grades.map((g) => (g === 0 ? 'R' : g)).join(', ')}</td>
            <td>{STATUS_LABELS[l.status]}</td>
            <td>{l.reviewedBy ?? '—'}</td>
            <td>{l.buildTestedBy ?? '—'}</td>
            <td>{pulls.has(l.id) ? 'A change is waiting' : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Admin>
