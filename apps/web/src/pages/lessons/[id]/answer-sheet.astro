---
// One-page printable answer sheet for a lesson (answer-sheets spec). The questions come from the
// lesson text, so the sheet always matches its lesson. Learners write a nickname or team name,
// never a surname (CLAUDE.md §7). The sheet code says which version of the questions was used,
// so answers can later be entered in the app against the right lesson.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrintButton from '../../../components/PrintButton.astro';
import { localHref, m, pageLang } from '../../../i18n';
import { localLesson } from '../../../lessons/translations';
import { getLessons, type LessonEntry } from '../../../lessons/load';
import { answerSheet, sheetCode, sheetIsDense } from '../../../lessons/answers';

export async function getStaticPaths() {
  const lessons = await getLessons();
  // Junior lessons (phase 0) use the picture mission sheets instead (spec junior.md FR-6).
  return lessons
    .filter((lesson) => lesson.data.phase !== 0)
    .map((lesson) => ({ params: { id: lesson.id }, props: { lesson, lessons } }));
}

interface Props {
  lesson: LessonEntry;
  lessons: LessonEntry[];
}

const { lesson, lessons } = Astro.props;
// The lesson in this page's language when a translation may be shown (spec §2.7), else English.
const local = await localLesson(lesson, pageLang(), lessons);
const { data } = local;
const textLang = local.lang === pageLang() ? undefined : local.lang;
const sections = answerSheet(local.body, local.steps);
const dense = sheetIsDense(sections);
const code = await sheetCode(lesson.id, local.lang, sections, data.assessment);
let number = 0;
---

<BaseLayout title={m.sheet_title({ title: data.title })}>
  <p class="back">
    <a href={localHref(`/lessons/${lesson.id}/`)}>← {data.title}</a>
  </p>
  <PrintButton label={m.sheet_print()} />

  <article class:list={['answer-sheet', { dense }]} data-sheet-code={code}>
    <h1>{m.sheet_title({ title: data.title })}</h1>
    <p class="meta">{m.sheet_lesson({ id: lesson.id, phase: data.phase })}</p>

    <div class="who">
      <div>{m.sheet_name()}</div>
      <div>{m.sheet_members()}</div>
      <div>{m.sheet_date()}</div>
    </div>

    {sections.map((section) => {
      const steps = section.items.find((item) => item.kind === 'steps');
      return (
        <section>
          <h2>
            <span aria-hidden="true">☐</span> <span lang={textLang}>{section.label}</span>
            {steps && steps.kind === 'steps' && (
              <span class="steps">
                {m.sheet_steps_done()}{' '}
                {Array.from({ length: steps.count }, (_, i) => `☐ ${i + 1}`).join('  ')}
              </span>
            )}
          </h2>
          {section.step === 'Make' && <div class="box">{m.sheet_make_box()}</div>}
          {section.items.map((item) =>
            item.kind === 'question' ? (
              <div class="question">
                <p lang={textLang}>
                  <strong>{++number}.</strong> {item.text}
                </p>
                <div class="line" />
                <div class="line extra" />
              </div>
            ) : item.kind === 'table' ? (
              <table lang={textLang}>
                <thead>
                  <tr>
                    {item.head.map((cell) => (
                      <th scope="col">{cell}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {item.rows.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : null
          )}
        </section>
      );
    })}

    <section>
      <h2>{m.lesson_assessment_title()}</h2>
      <table class="check" lang={textLang}>
        <tbody>
          {data.assessment.map((item) => (
            <tr>
              <td>{item}</td>
              <td>☐ {m.sheet_yes()}</td>
              <td>☐ {m.sheet_not_yet()}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <div class="end">
      <div>{m.sheet_checked_by()}</div>
      <div>{m.sheet_working()} ☐</div>
    </div>
    <p class="code">
      {m.sheet_code({ code })} · {m.sheet_keep()}
    </p>
  </article>
</BaseLayout>

<style>
  .answer-sheet {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .answer-sheet h1 {
    font-size: 1.4rem;
    margin: 0 0 1mm;
  }

  .meta,
  .code {
    font-size: 0.8rem;
  }

  .who {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr;
    gap: 1mm 4mm;
    margin: 0 0 2mm;
  }

  .who div,
  .end div {
    padding-top: 5mm;
    border-bottom: 1px solid currentColor;
    font-size: 0.8rem;
  }

  .answer-sheet h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4mm;
    margin: 2mm 0 0.5mm;
    border-bottom: 1.5px solid currentColor;
    font-size: 1.05rem;
  }

  .steps {
    font-size: 0.8rem;
    font-weight: 400;
  }

  .question p {
    margin: 0;
  }

  .line {
    height: 5.5mm;
    border-bottom: 1px solid #777;
  }

  .dense .line.extra {
    display: none;
  }

  .answer-sheet table {
    margin: 1mm 0;
    border-collapse: collapse;
    font-size: 0.85rem;
    break-inside: avoid;
  }

  .answer-sheet th,
  .answer-sheet td {
    min-width: 18mm;
    height: 5mm;
    padding: 0.5mm 2mm;
    border: 1px solid currentColor;
    text-align: left;
  }

  .answer-sheet .check td {
    height: auto;
    padding: 0.3mm 1.5mm;
    font-size: 0.8rem;
  }

  .answer-sheet .check td + td {
    min-width: 0;
    white-space: nowrap;
  }

  .box {
    height: 15mm;
    padding: 1mm 2mm;
    border: 1px solid currentColor;
    font-size: 0.8rem;
  }

  .end {
    display: flex;
    gap: 4mm;
    margin-top: 2mm;
  }

  .end div {
    flex: 1;
  }

  .code {
    margin-top: 1.5mm;
  }

  @media print {
    @page {
      size: A4;
      margin: 10mm 12mm;
    }

    .back {
      display: none !important;
    }

    .answer-sheet {
      font-size: 9.5pt;
      line-height: 1.25;
    }

    .answer-sheet h1 {
      font-size: 14pt;
    }

    .answer-sheet h2 {
      font-size: 11pt;
    }

    .meta,
    .code,
    .steps,
    .who div,
    .end div,
    .box,
    .answer-sheet .check td {
      font-size: 8.5pt;
    }

    .answer-sheet table {
      font-size: 9pt;
    }
  }
</style>
