---
// Slides view of a lesson (M2 spec FR-4): for a projector or a phone shared with a group.
// One slide per screen; swipe or scroll sideways without JavaScript; arrow keys and buttons with it.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localHref, m, pageLang } from '../../../i18n';
import { getLessons, type LessonEntry } from '../../../lessons/load';
import { stepsFor } from '../../../lessons/schema';
import { gradesLabel } from '../../../lessons/labels';
import { localLesson } from '../../../lessons/translations';
import { resolveImages, splitSections } from '../../../lessons/slides';

// Built URLs of every lesson image, so slides can show the same diagrams as the handbook.
const imageUrls = import.meta.glob<string>('../../../../../../content/lessons/*/images/*', {
  eager: true,
  query: '?url',
  import: 'default'
});

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson, lessons } }));
}

interface Props {
  lesson: LessonEntry;
  lessons: LessonEntry[];
}

const { lesson, lessons } = Astro.props;
// The lesson in this page's language when a translation may be shown (spec §2.7), else English.
const local = await localLesson(lesson, pageLang(), lessons);
const { data } = local;
const textLang = local.lang === pageLang() ? undefined : local.lang;
const html = local.entry.rendered?.html;
if (!html) throw new Error(`${lesson.id}: no rendered HTML for the slides view`);
const urlFor = (src: string) =>
  imageUrls[`../../../../../../content/lessons/${lesson.id}/${src.replace(/^\.\//, '')}`];
// Sections are matched to the lesson's steps by position, so translated headings work too.
const steps = splitSections(resolveImages(html, urlFor)).filter((_, i) =>
  stepsFor(data.phase).includes(local.steps[i] ?? '')
);
const total = 3 + steps.length + 1;
---

<BaseLayout title={`${data.title}: ${m.lesson_slides_link()}`}>
  <p class="back">
    <a href={localHref(`/lessons/${lesson.id}/`)}>← {m.slides_back()}</a>
  </p>
  <p class="muted hint">{m.slides_hint()}</p>

  <div class="deck" tabindex="0" aria-label={data.title} data-deck>
    <section class="slide title-slide" aria-label={m.slides_counter({ current: 1, total })}>
      <h1 lang={textLang}>{data.title}</h1>
      <p class="facts">
        {gradesLabel(data.grades)} · {m.lesson_duration({ minutes: data.duration_minutes })}
      </p>
      <h2>{m.lesson_outcomes_title()}</h2>
      <ul lang={textLang}>
        {data.outcomes.map((o) => (
          <li>{o}</li>
        ))}
      </ul>
    </section>

    <section class="slide" aria-label={m.slides_counter({ current: 2, total })}>
      <h2>{m.lesson_parts_title()}</h2>
      <ul lang={textLang}>
        {data.parts.map((p) => (
          <li>
            {p.qty} × {p.item}
          </li>
        ))}
      </ul>
    </section>

    <section class="slide safety" aria-label={m.slides_counter({ current: 3, total })}>
      <h2>⚠ {m.lesson_safety_title()}</h2>
      {data.safety.adult_help && <p class="adult">{m.lesson_adult_help()}</p>}
      <ul lang={textLang}>
        {data.safety.notes.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    </section>

    {steps.map((step, i) => (
      <section
        class="slide"
        lang={textLang}
        aria-label={m.slides_counter({ current: 4 + i, total })}
      >
        <h2>{step.heading}</h2>
        <div set:html={step.html} />
      </section>
    ))}

    <section class="slide" aria-label={m.slides_counter({ current: total, total })}>
      <h2>{m.lesson_assessment_title()}</h2>
      <ul class="checks" lang={textLang}>
        {data.assessment.map((a) => (
          <li>{a}</li>
        ))}
      </ul>
    </section>
  </div>

  <div class="controls" data-controls hidden>
    <button type="button" class="nav" data-prev aria-label={m.slides_previous()}>
      ←
    </button>
    <p class="counter" aria-live="polite" data-counter></p>
    <button type="button" class="nav" data-next aria-label={m.slides_next()}>
      →
    </button>
  </div>
  <template data-counter-text>
    {m.slides_counter({ current: '{current}', total: '{total}' })}
  </template>
</BaseLayout>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const controls = document.querySelector<HTMLElement>('[data-controls]');
  const counter = document.querySelector<HTMLElement>('[data-counter]');
  const pattern =
    document.querySelector<HTMLTemplateElement>('[data-counter-text]')?.content.textContent ?? '';

  if (deck && controls && counter) {
    const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
    const current = () => Math.round(deck.scrollLeft / deck.clientWidth);
    const go = (i: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, i));
      deck.scrollTo({ left: target * deck.clientWidth, behavior: 'smooth' });
    };
    const update = () => {
      counter.textContent = pattern
        .replace('{current}', String(current() + 1))
        .replace('{total}', String(slides.length));
    };

    controls.hidden = false;
    update();
    deck.addEventListener('scroll', update, { passive: true });
    document.querySelector('[data-prev]')?.addEventListener('click', () => go(current() - 1));
    document.querySelector('[data-next]')?.addEventListener('click', () => go(current() + 1));
    deck.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown') {
        e.preventDefault();
        go(current() + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        go(current() - 1);
      }
    });
  }
</script>

<style>
  .back,
  .hint {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .deck {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-height: min(70vh, 34rem);
    padding: var(--space-6);
    font-size: 1.25rem;
    overflow-wrap: anywhere;
  }

  .slide h1 {
    font-size: clamp(1.75rem, 7vw, 2.75rem);
  }

  .slide h2 {
    margin-top: 0;
    font-size: clamp(1.4rem, 5vw, 2rem);
  }

  .slide :global(img) {
    display: block;
    max-width: 100%;
    max-height: 40vh;
    height: auto;
    margin: var(--space-3) auto;
  }

  .slide.safety .adult {
    font-weight: 700;
  }

  .checks {
    list-style: '☐  ';
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .controls[hidden] {
    display: none;
  }

  .counter {
    margin: 0;
  }

  .nav {
    min-width: var(--tap);
    min-height: var(--tap);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-lg);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .deck {
      scroll-behavior: auto;
    }
  }
</style>
