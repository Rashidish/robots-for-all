---
import { worldPublished } from '../../lessons/worlds';
import { hidden, isOff } from '../../withdrawn';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloadLesson from '../../components/DownloadLesson.astro';
import HelperPanel from '../../components/HelperPanel.astro';
import PrintButton from '../../components/PrintButton.astro';
import { findTemplate, templateFile, templatePage } from '../../templates/load';
import { starterLink } from '../../lessons/programs';
import { localHref, m, pageLang } from '../../i18n';
import { localLesson, localTitles } from '../../lessons/translations';
import { getLessons, type LessonEntry } from '../../lessons/load';
import { gradesLabel, phaseLabel } from '../../lessons/labels';
import { missionKey } from '../../junior/missions';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson, lessons } }));
}

interface Props {
  lesson: LessonEntry;
  /** The lessons visible in this build, for prerequisite and next links. */
  lessons: LessonEntry[];
}

const { lesson, lessons } = Astro.props;
// The lesson in this page's language when a translation may be shown (spec §2.7), else English.
const local = await localLesson(lesson, pageLang(), lessons);
const titles = await localTitles(lessons, pageLang());
// Lesson text in another language than the page (English on an isiZulu page) says so.
const textLang = local.lang === pageLang() ? undefined : local.lang;
const prerequisites = lesson.data.prerequisites.filter((id) => titles[id]);
const next = lesson.data.next && titles[lesson.data.next] ? lesson.data.next : null;
const { data } = local;
const { Content } = await render(local.entry);
const sheets = data.templates
  .filter((name) => !hidden('template', `${lesson.id}/${name}`))
  .flatMap((name) => findTemplate(lesson.id, name) ?? []);
// A withdrawn world: the lesson still opens its program, on the plain micro:bit (spec §2.4).
// So does a world not yet published on this site (more content spec §2.2).
const world =
  data.world && !hidden('world', data.world) && (__RFA_SHOW_DRAFTS__ || worldPublished(data.world))
    ? data.world
    : null;
const starter = data.starter_program
  ? starterLink(lesson.id, data.starter_program, world, local.programName)
  : undefined;
const withdrawnHere = isOff('lesson', lesson.id);
// Junior lessons open their missions and print the picture mission sheets (spec junior.md FR-6).
const missionName = (id: string) =>
  (m as unknown as Record<string, () => string>)[missionKey(id)]?.() ?? id;
const junior = data.phase === 0;
---

<BaseLayout title={data.title}>
  <p class="back">
    <a href={localHref('/lessons/')}>← {m.lesson_back()}</a>
  </p>

  {withdrawnHere && (
    <p class="draft" role="note">
      {m.lesson_withdrawn_notice()}
    </p>
  )}

  {local.notice && (
    <p class="draft" role="note">
      {local.notice === 'english'
        ? m.lesson_in_english_notice()
        : local.notice === 'stale'
          ? m.lesson_translation_stale_notice()
          : m.lesson_translation_draft_notice()}
    </p>
  )}

  {data.status !== 'published' && (
    <p class="draft" role="note">
      {m.lesson_draft_notice()}
    </p>
  )}

  <h1 lang={textLang}>{data.title}</h1>

  <ul class="facts">
    <li>{phaseLabel(data.phase)}</li>
    <li>{gradesLabel(data.grades)}</li>
    <li>{m.lesson_duration({ minutes: data.duration_minutes })}</li>
    <li>{m.lesson_cost({ amount: data.cost_estimate_zar })}</li>
    <li>{m.lesson_mechanism({ mechanism: data.mechanism })}</li>
  </ul>

  <p>
    <a class="button" href={localHref(`/lessons/${lesson.id}/slides/`)} data-offline>
      {m.lesson_slides_link()}
    </a>
    {!junior && (
      <a class="button" href={localHref(`/lessons/${lesson.id}/answer-sheet/`)} data-offline>
        {m.lesson_answer_sheet_link()}
      </a>
    )}
  </p>

  {junior && (
    <section class="code-start" aria-labelledby="missions-title">
      <h2 id="missions-title">{m.lesson_junior_missions_title()}</h2>
      <p>{m.lesson_junior_missions_about()}</p>
      <ul class="missions">
        {data.junior_missions.map((id) => (
          <li>
            <a class="button" href={localHref(`/code/junior/#${id}`)}>
              {m.lesson_junior_open({ mission: missionName(id) })}
            </a>
            <a href={localHref(`/code/junior/sheet/${id}/`)} data-offline>
              {m.lesson_junior_sheet({ mission: missionName(id) })}
            </a>
          </li>
        ))}
      </ul>
      <p>
        <a href={localHref('/code/junior/cards/')} data-offline>
          {m.lesson_junior_cards()}
        </a>
      </p>
    </section>
  )}

  <DownloadLesson />

  <section
    class:list={['safety', { 'adult-help': data.safety.adult_help }]}
    aria-labelledby="safety-title"
  >
    <h2 id="safety-title">⚠ {m.lesson_safety_title()}</h2>
    {data.safety.adult_help && <p class="adult">{m.lesson_adult_help()}</p>}
    <ul lang={textLang}>
      {data.safety.notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="outcomes-title">
    <h2 id="outcomes-title">{m.lesson_outcomes_title()}</h2>
    <ul lang={textLang}>
      {data.outcomes.map((outcome) => (
        <li>{outcome}</li>
      ))}
    </ul>
    {data.concepts.length > 0 && (
      <p class="concepts">
        <strong>{m.lesson_concepts_title()}:</strong>{' '}
        <span lang={textLang}>{data.concepts.join(', ')}</span>
      </p>
    )}
  </section>

  {prerequisites.length > 0 && (
    <section aria-labelledby="prereq-title">
      <h2 id="prereq-title">{m.lesson_prerequisites_title()}</h2>
      <ul>
        {prerequisites.map((id) => (
          <li>
            <a href={localHref(`/lessons/${id}/`)}>{titles[id]}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="parts" aria-labelledby="parts-title">
    <h2 id="parts-title">{m.lesson_parts_title()}</h2>
    <ul lang={textLang}>
      {data.parts.map((part) => (
        <li>
          {part.qty} × {part.item}
          {part.substitute && (
            <span class="muted"> ({m.lesson_substitute({ substitute: part.substitute })})</span>
          )}
        </li>
      ))}
    </ul>
  </section>

  {sheets.length > 0 && (
    <section class="templates" aria-labelledby="templates-title">
      <h2 id="templates-title">{m.lesson_templates_title()}</h2>
      <ul>
        {sheets.map((t) => (
          <li>
            <a
              href={localHref(templatePage(t.lesson, t.name))}
              lang={local.sheets[t.name] || pageLang() === 'en' ? undefined : 'en'}
              data-offline
            >
              {local.sheets[t.name]?.title ?? t.sheet.title}
            </a>
            <a
              class="muted"
              href={templateFile(t.lesson, t.name, local.sheets[t.name] ? local.lang : 'en')}
              data-offline
              download
            >
              ({m.template_download()})
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="lesson-body" lang={textLang}>
    <Content />
  </div>

  <section class="assessment" aria-labelledby="assessment-title">
    <h2 id="assessment-title">{m.lesson_assessment_title()}</h2>
    <ul lang={textLang}>
      {data.assessment.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <HelperPanel lesson={lesson.id} />

  {starter && (
    <section class="code-start" aria-labelledby="code-start-title">
      <h2 id="code-start-title">{m.lesson_code_title()}</h2>
      <p>
        {data.hardware === 'none'
          ? m.lesson_code_no_hardware()
          : data.hardware === 'microbit'
            ? m.lesson_code_microbit()
            : m.lesson_code_microbit_motor()}
      </p>
      <p>
        <a class="button" href={localHref(starter)}>
          {m.lesson_open_in_editor()}
        </a>
      </p>
    </section>
  )}

  {data.syllabus_links.length > 0 && (
    <section aria-labelledby="syllabus-title">
      <h2 id="syllabus-title">{m.lesson_syllabus_title()}</h2>
      <ul>
        {data.syllabus_links.map((link) => (
          <li>
            {link.subject}: {link.topic}
          </li>
        ))}
      </ul>
    </section>
  )}

  {next && (
    <p class="next">
      <strong>{m.lesson_next_title()}:</strong>{' '}
      <a href={localHref(`/lessons/${next}/`)}>{titles[next]}</a>
    </p>
  )}

  <PrintButton label={m.lesson_print()} />
</BaseLayout>

<style>
  /* Each sheet link and its download link are full touch targets, even when a long
     (translated) title wraps onto two lines (WCAG 2.2 target size). */
  .templates a {
    display: inline-block;
    min-height: 24px;
    padding-block: 2px;
  }

  .back {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .draft {
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    font-weight: 600;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
  }

  .parts {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .missions {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .missions li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .parts h2,
  .code-start h2 {
    margin-top: 0;
  }

  .code-start {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
  }

  .safety {
    margin: var(--space-6) 0;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
  }

  .safety.adult-help {
    border-color: var(--color-accent);
  }

  .safety h2 {
    margin-top: 0;
  }

  .safety .adult {
    font-weight: 700;
  }

  .assessment ul {
    list-style: '☐  ';
  }

  .next {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  button.button {
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  @media print {
    .back,
    .code-start .button {
      display: none !important;
    }

    .facts li,
    .parts {
      border-color: #999;
    }

    .lesson-body h2 {
      break-after: avoid;
    }

    .parts,
    .lesson-body p {
      break-inside: avoid;
    }
  }
</style>
