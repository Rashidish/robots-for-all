---
import { gradesLabel, phaseLabel } from '../lessons/labels';
import { localHref, m } from '../i18n';
import type { LessonEntry } from '../lessons/load';

interface Props {
  lesson: LessonEntry;
  /** The title in the page's language (spec §2.7); English when none may be shown. */
  title?: string;
  /** Set when the title is in another language than the page. */
  titleLang?: string | undefined;
}

const { data } = Astro.props.lesson;
const { title = data.title, titleLang } = Astro.props;
---

<article
  class="card"
  data-lesson
  data-grades={data.grades.join(' ')}
  data-mechanism={data.mechanism}
  data-cost={data.cost_estimate_zar}
>
  <h2>
    <a href={localHref(`/lessons/${data.id}/`)} lang={titleLang}>
      {title}
    </a>
  </h2>
  <p class="meta">
    {phaseLabel(data.phase)} · {gradesLabel(data.grades)} ·{' '}
    {m.lesson_duration({ minutes: data.duration_minutes })}
  </p>
  {data.status !== 'published' && <p class="draft">{m.lesson_draft_notice()}</p>}
</article>

<style>
  .card {
    padding: var(--space-4);
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  h2 {
    margin: 0 0 var(--space-2);
  }

  h2 a {
    display: inline-block;
    min-height: var(--tap);
    padding-top: var(--space-1);
  }

  .meta,
  .draft {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .draft {
    margin-top: var(--space-2);
    font-weight: 600;
  }
</style>
