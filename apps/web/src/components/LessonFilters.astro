---
// Filters for the lessons list (FR-9). Hidden without JavaScript, when every lesson simply shows.
import { localHref, m } from '../i18n';
import type { LessonEntry } from '../lessons/load';
import { gradesText } from '../lessons/schema';

interface Props {
  lessons: LessonEntry[];
}

const { lessons } = Astro.props;
const grades = [...new Set(lessons.flatMap((l) => l.data.grades))].sort((a, b) => a - b);
const mechanisms = [...new Set(lessons.map((l) => l.data.mechanism))].sort();
---

<form class="filters" data-filters hidden aria-label={m.lessons_filter_label()}>
  <label>
    {m.lessons_filter_grade()}
    <select name="grade">
      <option value="">{m.lessons_filter_any()}</option>
      {grades.map((g) => (
        <option value={g}>{gradesText([g])}</option>
      ))}
    </select>
  </label>
  <label>
    {m.lessons_filter_mechanism()}
    <select name="mechanism">
      <option value="">{m.lessons_filter_any()}</option>
      {mechanisms.map((mech) => (
        <option value={mech}>{mech}</option>
      ))}
    </select>
  </label>
  <label>
    {m.lessons_filter_cost()}
    <select name="cost">
      <option value="">{m.lessons_filter_any()}</option>
      <option value="10">{m.lessons_filter_cost_low()}</option>
      <option value="30">{m.lessons_filter_cost_mid()}</option>
    </select>
  </label>
</form>
<p class="muted" data-filter-none role="status" hidden>
  {m.lessons_filter_none()}
  <a href={localHref('/lessons/')}>{m.lessons_filter_reset()}</a>
</p>

<script>
  import { fromQuery, matches, toQuery, type Filters } from '../lessons/filter';

  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const none = document.querySelector<HTMLElement>('[data-filter-none]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-lesson]')];

  const apply = (f: Filters) => {
    let shown = 0;
    for (const card of cards) {
      const ok = matches(
        {
          grades: (card.dataset['grades'] ?? '').split(' ').map(Number),
          mechanism: card.dataset['mechanism'] ?? '',
          cost: Number(card.dataset['cost'])
        },
        f
      );
      card.hidden = !ok;
      if (ok) shown++;
    }
    if (none) none.hidden = shown > 0;
  };

  if (form) {
    form.hidden = false;
    const initial = fromQuery(new URLSearchParams(window.location.search));
    const set = (name: string, value: number | string | null) => {
      const select = form.elements.namedItem(name);
      if (select instanceof HTMLSelectElement) select.value = value === null ? '' : String(value);
    };
    set('grade', initial.grade);
    set('mechanism', initial.mechanism);
    set('cost', initial.maxCost);
    apply(initial);

    form.addEventListener('change', () => {
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form)) {
        if (typeof value === 'string' && value) params.set(key, value);
      }
      const f = fromQuery(params);
      apply(f);
      history.replaceState(null, '', `${window.location.pathname}${toQuery(f)}`);
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .filters[hidden],
  [data-filter-none][hidden] {
    display: none;
  }

  label {
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  select {
    min-height: var(--tap);
    min-width: 7.5rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 400;
  }
</style>
